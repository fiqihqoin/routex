# ==================== TRANSACTION API (Internal & External) ====================
server {
    listen 80;
    server_name api.caishenengine.com sandbox.caishenengine.com production.caishenengine.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.caishenengine.com sandbox.caishenengine.com production.caishenengine.com;

    ssl_certificate /etc/nginx/certs/caishenengine.crt;
    ssl_certificate_key /etc/nginx/certs/caishenengine.key;

    location / {
        proxy_pass http://transaction-api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
