# ==================== FE (Homepage + Merchant Portal) ====================
server {
    listen 80;
    server_name caishenengine.com app.caishenengine.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name caishenengine.com app.caishenengine.com;

    ssl_certificate /etc/nginx/certs/caishenengine.crt;
    ssl_certificate_key /etc/nginx/certs/caishenengine.key;

    location / {
        proxy_pass http://fe:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ==================== DOCS ====================
server {
    listen 80;
    server_name docs.caishenengine.com;
    return 301 https://$host$request_uri;
